<?xml version="1.0" encoding="utf-8" ?>
<resources>

    <style
        name="TextAppearance.Tasks.ToolbarTitle"
        parent="TextAppearance.MaterialComponents.Headline6"
    >
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.Tasks.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!--
      Default chip look = "Urgent" (red). Override background/text color at bind time
      in TasksAdapter based on task.tag, e.g.:
        chipTag.setChipBackgroundColorResource(R.color.tag_work_bg)
        chipTag.setTextColor(ContextCompat.getColor(context, R.color.tag_work_text))
    -->
    <style
        name="Widget.Tasks.Chip"
        parent="Widget.MaterialComponents.Chip.Entry"
    >
        <item name="chipBackgroundColor">@color/tag_urgent_bg</item>
        <item name="android:textColor">@color/tag_urgent_text</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

</resources>
